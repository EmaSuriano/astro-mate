---
import { getSectionLink, type Section } from "../helpers/sections";
import type { Config } from "../types";
import ThemeSwitch from "./ThemeSwitch.astro";

type Props = Pick<Config, "name"> & { sections: Section[]; };

const { sections, name } = Astro.props;
const sectionLinks = sections.map(getSectionLink);
---

<div class="navbar absolute inset-x-0 top-0 z-20 bg-transparent text-[var(--color-ink)]">
  <div class="mx-auto flex w-full max-w-6xl items-center px-6 md:px-12 lg:px-16">
    <div class="flex-1">
      <a class="btn btn-ghost px-0 text-lg font-medium normal-case" href="/">{name}</a>
    </div>
    <div class="flex-none">
      <ul class="menu menu-horizontal items-center gap-1 p-0 text-[var(--color-muted)]">
        <li><ThemeSwitch /></li>
        {sectionLinks.map((section) => (
          <li class="hidden sm:inline">
            <a class="hover:text-[var(--color-ink)]" href={section.href}>{section.label}</a>
          </li>
        ))}
        <li class="dropdown dropdown-end inline sm:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-sm">Sections</div>
          <ul tabindex="-1" class="menu dropdown-content z-20 mt-2 w-44 rounded-box border border-[var(--color-rule)] bg-base-100 p-2 text-base-content shadow">
            {sectionLinks.map((section) => (
              <li><a href={section.href}>{section.label}</a></li>
            ))}
          </ul>
        </li>
      </ul>
    </div>
  </div>
</div>
