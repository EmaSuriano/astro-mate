---
type Props = { class?: string };
const { class: className = "mate-mark h-40 w-40 text-[var(--color-ink)] md:h-48 md:w-48" } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 200 200"
  fill="none"
  role="img"
  aria-labelledby="mateMarkTitle"
>
  <title id="mateMarkTitle">Mate</title>
  <g fill="currentColor">
    <circle cx="78" cy="42" r="7"></circle>
    <circle cx="98" cy="28" r="9"></circle>
    <circle cx="118" cy="40" r="6"></circle>
  </g>
  <g
    stroke="currentColor"
    stroke-width="12"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  >
    <path d="M118 78 L158 38"></path>
    <path d="M150 36 h16" stroke-width="10"></path>
    <ellipse cx="100" cy="88" rx="42" ry="16"></ellipse>
    <path d="M58 88 C58 88 56 130 70 152 C82 170 118 170 130 152 C144 130 142 88 142 88"></path>
    <path d="M86 164 C92 172 108 172 114 164" stroke-width="10"></path>
  </g>
</svg>
