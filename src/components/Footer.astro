---
import type { Config } from "../types";

type Props = Pick<Config, "name" | "social">;

const { name, social } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)] bg-[var(--color-paper)] px-6 py-10 text-[var(--color-muted)] md:px-12 lg:px-16">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-4 font-ui text-sm sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-8 sm:gap-y-3">
    <p class="font-display text-base tracking-tight text-[var(--color-ink)]">{name}</p>
    <p class="text-[var(--color-muted)]">A quiet portfolio theme</p>
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {social.map((link) => (
        <li>
          <a class="transition-colors hover:text-[var(--color-accent)]" href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
    <p class="sm:ml-auto">&copy; {currentYear}</p>
  </div>
</footer>
