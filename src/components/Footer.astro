---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)] bg-[var(--color-paper)] px-6 py-10 text-[var(--color-muted)] md:px-12 lg:px-16">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 text-sm sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {currentYear}</p>
    <p>Built with <a class="link link-hover text-[var(--color-accent)]" href="https://astro.build/">Astro</a> + <a class="link link-hover text-[var(--color-accent)]" href="https://daisyui.com/">DaisyUI</a></p>
  </div>
</footer>
