---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Not found">
  <section class="section-shell relative flex min-h-screen items-center justify-center overflow-hidden px-6">
    <div class="hero-atmosphere pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="hero-spotlight"></div>
      <div class="hero-grain"></div>
    </div>
    <div class="relative z-10 max-w-lg text-center">
      <h1 class="font-display text-8xl md:text-9xl">404</h1>
      <h2 class="mt-4 text-2xl text-[var(--color-muted)] md:text-3xl">There isn&apos;t anything here</h2>
      <a class="btn btn-primary mt-10" href="/">Back home</a>
    </div>
  </section>
</Layout>
