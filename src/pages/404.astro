---
import Layout from "../layouts/Layout.astro";
import Triangle from "../components/Triangle.astro";
---

<Layout title="404 — Not found">
  <section class="hero relative min-h-screen">
    <Triangle
      className="bg-accent h-[35vh] w-[95vw] md:h-[80vh] md:w-[60vw]"
      position="top-left"
    />
    <Triangle
      className="bg-primary h-[25vh] w-[75vw] md:h-[35vh] md:w-[60vw]"
      position="top-right"
    />
    <Triangle
      className="bg-secondary h-[20vh] w-[50vw]"
      position="bottom-right"
    />
    <div class="hero-content z-10 text-center">
      <div class="max-w-lg">
        <h1 class="text-8xl font-bold text-primary md:text-9xl">404</h1>
        <h2 class="mt-4 text-3xl font-semibold text-secondary md:text-4xl">
          There isn&apos;t anything here
        </h2>
        <a class="btn btn-primary mt-8" href="/">Back home</a>
      </div>
    </div>
  </section>
</Layout>
