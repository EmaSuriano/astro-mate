---
import Article from "../components/Article.astro";
import Title from "../components/Title.astro";
import { getSectionLink } from "../helpers/sections";
import type { Config } from "../types";

const SECTION_ID = "about";

type Props = Pick<Config, "aboutMe" | "avatar">;

const { aboutMe, avatar } = Astro.props;

const { label, href } = getSectionLink(SECTION_ID);

const content = await fetch(aboutMe).then((res) => res.text());
---

<section class="section-shell min-h-screen py-20 md:py-28" id={SECTION_ID}>
  <div class="mx-auto flex w-full max-w-6xl flex-col items-start gap-12 px-6 md:flex-row md:gap-16 md:px-12 lg:px-16">
    <div class="flex min-w-0 flex-1 flex-col gap-8">
      <Title href={href} label={label} />
      <Article content={content} />
    </div>
    <div class="avatar mx-auto w-56 shrink-0 md:mx-0 md:w-72">
      <img class="rounded-full ring-1 ring-[var(--color-rule)] transition-all hover:ring-4 hover:ring-[var(--color-accent)] hover:scale-105" src={avatar} alt="Avatar" height={400} width={400} loading="lazy" decoding="async" />
    </div>
  </div>
</section>
