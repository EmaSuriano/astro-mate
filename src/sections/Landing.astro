---
import { Icon } from "astro-icon/components";
import ScrollIcon from "../components/ScrollIcon.astro";
import type { Config } from "../types";

type Props = Pick<Config, "name" | "roles" | "social">;

const { name, roles, social } = Astro.props;
const rolesLine = roles.join(" · ");
---

<section
  class="relative isolate min-h-[85vh] overflow-hidden bg-base-100"
  id="home"
>
  <div class="hero-atmosphere pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-spotlight"></div>
    <div class="hero-grain"></div>
  </div>

  <div
    class="relative z-10 mx-auto flex min-h-[85vh] w-full max-w-6xl flex-col justify-center px-6 py-24 md:px-12 lg:px-16"
  >
    <div class="max-w-2xl text-left">
      <h1 class="font-display text-5xl font-normal tracking-tight text-base-content md:text-6xl lg:text-7xl">
        Hello, I&apos;m {name}
      </h1>
      <p class="mt-5 text-lg text-[var(--color-muted)] md:text-xl">
        {rolesLine}
      </p>
      <ul class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3">
        {
          social.map((link) => (
            <li>
              <a
                class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
                href={link.href}
                aria-label={link.label}
              >
                <Icon name={link.icon} class="h-4 w-4" aria-hidden="true" />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="absolute bottom-10 left-6 md:left-12 lg:left-16">
      <ScrollIcon href="#about" />
    </div>
  </div>
</section>
