---
import { Icon } from "astro-icon/components";
import ScrollIcon from "../components/ScrollIcon.astro";
import type { Config } from "../types";

type Props = Pick<Config, "name" | "roles" | "social">;

const { name, roles, social } = Astro.props;

const stripEmoji = (value: string) =>
  value
    .replace(/\p{Extended_Pictographic}/gu, "")
    .replace(/\s+/g, " ")
    .trim();

const rolesLine = roles.map(stripEmoji).filter(Boolean).join(" · ");
const year = new Date().getFullYear();
---

<section
  class="hero-specimen relative isolate min-h-[85vh] overflow-hidden bg-[var(--color-paper)] text-[var(--color-ink)]"
  id="home"
>
  <div class="hero-whisper" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto flex min-h-[85vh] w-full max-w-6xl flex-col px-6 pb-24 pt-28 md:px-12 lg:px-16"
  >
    <header class="hero-masthead">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <p class="font-display text-2xl font-normal tracking-tight text-[var(--color-ink)] md:text-3xl">
          {name}
        </p>
        <p
          class="font-ui text-[0.7rem] font-medium uppercase tracking-[0.22em] text-[var(--color-muted)]"
        >
          Portfolio · Astro theme · {year}
        </p>
      </div>
      <div class="hero-double-rule" aria-hidden="true"></div>
    </header>

    <div class="mt-16 flex flex-1 flex-col justify-center md:mt-20">
      <div class="max-w-3xl text-left">
        <h1 class="font-display text-display font-normal tracking-tight text-[var(--color-ink)]">
          Hello, I&apos;m {name}.
        </h1>
        <p class="mt-6 max-w-xl font-serif text-lg text-[var(--color-muted)] md:text-xl">
          {rolesLine}
        </p>
        <ul class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 font-ui">
          {
            social.map((link) => (
              <li>
                <a
                  class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
                  href={link.href}
                  aria-label={link.label}
                >
                  <Icon name={link.icon} class="h-4 w-4" aria-hidden="true" />
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-12">
          <a
            class="font-ui text-sm text-[var(--color-ink)] underline-offset-4 transition-colors hover:text-[var(--color-accent)] hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
            href="#about"
          >
            Continue reading →
          </a>
        </p>
      </div>
    </div>

    <div class="absolute bottom-10 left-6 md:left-12 lg:left-16">
      <ScrollIcon href="#about" />
    </div>
  </div>
</section>
