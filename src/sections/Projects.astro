---
import Title from "../components/Title.astro";
import type { Config } from "../types";
import { getSectionLink } from "../helpers/sections";

const SECTION_ID = "projects";

type Props = Pick<Config, "projects">;

const { projects } = Astro.props;

const { label, href } = getSectionLink(SECTION_ID);
---

<section class="section-shell py-24 md:py-32" id={SECTION_ID}>
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-6 md:px-12 lg:px-16">
    <Title href={href} label={label} kicker="03 — Work." />
    <ul class="editorial-index">
      {projects.map((project) => (
        <li>
          <a class="index-row" href={project.href} target="_blank" rel="noopener noreferrer">
            <span class="index-year font-ui">{project.yearReleased}</span>
            <span class="index-body">
              <span class="index-title font-display">{project.name}</span>
              <span class="index-dek font-serif">{project.description}</span>
            </span>
            <span class="index-action font-ui">View →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
