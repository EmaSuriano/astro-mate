---
import Title from "../components/Title.astro";
import ProjectCard from "../components/ProjectCard.astro";
import type { Config } from "../types";
import { getSectionLink } from "../helpers/sections";

const SECTION_ID = "projects";

type Props = Pick<Config, "projects">;

const { projects } = Astro.props;

const { label, href } = getSectionLink(SECTION_ID);
---

<section class="section-shell min-h-screen py-20 md:py-28" id={SECTION_ID}>
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-6 md:px-12 lg:px-16">
    <Title href={href} label={label} />
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-8">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
