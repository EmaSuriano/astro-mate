---
import ArticleCard from "../components/ArticleCard.astro";
import Title from "../components/Title.astro";
import { getSectionLink } from "../helpers/sections";
import type { Config } from "../types";
import { articleListSchema } from "../validator";

const SECTION_ID = "writing";

type Props = Required<Pick<Config, "devToUser">>;

const { devToUser } = Astro.props;

const { label, href } = getSectionLink(SECTION_ID);

const articles = await fetch(`https://dev.to/api/articles?username=${devToUser}&per_page=6`).then((res) => res.json()).then(articleListSchema.parse);
---

<section class="section-shell min-h-screen py-20 md:py-28" id="writing">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-6 md:px-12 lg:px-16">
    <Title href={href} label={label} />
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-8">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </div>
</section>
