---
import Title from "../components/Title.astro";
import { getSectionLink } from "../helpers/sections";
import type { Config } from "../types";
import { articleListSchema } from "../validator";

const SECTION_ID = "writing";

type Props = Required<Pick<Config, "devToUser">>;

const { devToUser } = Astro.props;

const { label, href } = getSectionLink(SECTION_ID);

const articles = await fetch(`https://dev.to/api/articles?username=${devToUser}&per_page=6`)
  .then((res) => res.json())
  .then(articleListSchema.parse);
---

<section class="section-shell py-24 md:py-32" id="writing">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-6 md:px-12 lg:px-16">
    <Title href={href} label={label} kicker="04 — Writing." />
    <ul class="editorial-index">
      {articles.map((article) => (
        <li>
          <a class="index-row" href={article.url} target="_blank" rel="noopener noreferrer">
            <span class="index-year font-ui">
              {article.published_at
                ? new Date(article.published_at).getFullYear()
                : "—"}
            </span>
            <span class="index-body">
              <span class="index-title font-display">{article.title}</span>
              <span class="index-dek font-serif">{article.description}</span>
            </span>
            <span class="index-action font-ui">Read →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
